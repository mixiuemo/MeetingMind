# Copy this file to .env and adjust paths and service addresses.
HUIYI_MONGODB_URI=mongodb://127.0.0.1:27017
HUIYI_MONGODB_DATABASE=huiyi

HUIYI_ASR_MODEL_DIR=D:\path\to\funasr-nano-model
HUIYI_ASR_LANGUAGE=中文
HUIYI_ASR_NUM_THREADS=4
HUIYI_VAD_MODEL_PATH=D:\path\to\silero_vad.onnx
HUIYI_VAD_THRESHOLD=0.45
HUIYI_VAD_MIN_SILENCE_SECONDS=0.85
HUIYI_VAD_MIN_SPEECH_SECONDS=0.25
HUIYI_VAD_MAX_SPEECH_SECONDS=15

HUIYI_LLM_ENABLED=true
HUIYI_LLM_BASE_URL=http://127.0.0.1:11434/v1
HUIYI_LLM_API_KEY=ollama
HUIYI_LLM_MODEL=qwen3.5:4b
HUIYI_LLM_TIMEOUT_SECONDS=180
HUIYI_LLM_CHUNK_CHARACTERS=8000
HUIYI_LLM_MAX_TOKENS=1600
# Ollama qwen3.5 recommends none for fast structured extraction.
# Leave empty or change it when the third-party API does not support this field.
HUIYI_LLM_REASONING_EFFORT=none
